# Copy to .env and fill in. .env is git-ignored. Local dev only -
# on Databricks these come from job parameters + a secret scope (see config.py).
#
# Non-secret Dayforce config (base_uri / company / api_version / windows) has
# committed defaults in conf/settings.dev.yaml - only override here if needed.
# Credentials come from the OS keyring by default (keyring set dayforce-tafw
# username / password); set them below only to override the keyring.

# --- Dayforce Web Services API -------------------------------------------
# Endpoint root = {BASE_URI}/{COMPANY}/{API_VERSION}/Employees
DAYFORCE_BASE_URI=https://cantest261-services.dayforcehcm.com/api
DAYFORCE_COMPANY=bluedrop
DAYFORCE_API_VERSION=v1
DAYFORCE_USERNAME=                  # blank -> read from keyring (dayforce-tafw/username)
DAYFORCE_PASSWORD=                  # blank -> read from keyring (dayforce-tafw/password)
DAYFORCE_AUTH_MODE=basic            # basic | oauth2  (only basic is implemented today)
DAYFORCE_TEST_MODE=true             # informational once BASE_URI points at a test tenant

# --- Pacing / windows ---------------------------------------------------
DAYFORCE_MAX_RPM=90                 # stay under Dayforce's ~100 req/min ceiling
DAYFORCE_THROTTLE_SECONDS=0.2       # floor delay before each TAFW call
TAFW_LOOKBACK_DAYS=30               # how far back to sync
TAFW_HORIZON_DAYS=90               # how far forward to sync
TAFW_WINDOW_DAYS=30                 # per-call window (Dayforce caps at 31)
TAFW_STATUSES=APPROVED             # comma-separated; APPROVED is the staging feed

# Restrict the roster while developing (comma-separated XRefCodes). Empty =
# every employee returned by the Employees endpoint.
TAFW_EMPLOYEE_XREFS=

# --- Staging target ---------------------------------------------------
# writer: memory | local_delta | databricks  (databricks is auto-selected in the notebook)
TAFW_WRITER=memory
TAFW_STAGING_TABLE=staging.tafw_day_record
TAFW_LOCAL_DELTA_PATH=./spark-warehouse/tafw_day_record

# Expand a multi-day TAFW event into one row per calendar day.
TAFW_EXPAND_MULTI_DAY=false
