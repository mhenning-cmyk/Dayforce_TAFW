    "    add_missing_employee_department_columns_sql,\n",
    ")\n",
    "from tafw_ingest.get_tafw import DEFAULT_STATUSES, expand_tafw_records_to_days, fetch_tafw_records\n",
    "from tafw_ingest.hashing import normalize_hours\n",
    "from tafw_ingest.tafw_day_record_queries import (\n",
    "    CREATE_TAFW_DAY_RECORD_TABLE_SQL,\n",
