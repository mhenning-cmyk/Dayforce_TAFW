    "###### Dayforce Integration Service #########\n",
    "\n",
    "#Import python libaries\n",
    "import sys\n",
    "from datetime import UTC, datetime, timedelta\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "\n",
    "# Databricks notebooks get `dbutils` injected as a global automatically; it\n",
    "# never exists locally (script, REPL, or an interactive/Jupyter cell), so its\n",
    "# presence is how we tell the two environments apart. This has to run before\n",
    "# the `tafw_ingest` imports below: locally the package is on sys.path via\n",
    "# `pip install -e .`, but a Databricks Workspace notebook doesn't get that for\n",
    "# free, so `import tafw_ingest` 404s unless its `src/` dir is added first.\n",
    "IN_DATABRICKS = \"dbutils\" in globals()\n",
    "\n",
    "# Repo root = first ancestor holding conf/settings.dev.yaml. Databricks Git\n",
    "# folders, Git-sourced Jobs and local Jupyter all run a notebook with its own\n",
    "# folder as the working directory, so this finds the checkout wherever it lives\n",
    "# - no hardcoded /Workspace/Users/<you>/... path, which breaks for anyone else's\n",
    "# clone and for Jobs (they run from a temporary checkout, not your Git folder).\n",
    "try:\n",
    "    _here = Path(__file__).resolve()\n",
    "except NameError:  # no __file__ in an interactive/notebook cell\n",
    "    _here = Path.cwd()\n",
    "REPO_ROOT = next(\n",
    "    (p for p in (_here, *_here.parents) if (p / \"conf\" / \"settings.dev.yaml\").is_file()),\n",
    "    None,\n",
    ")\n",
    "if REPO_ROOT is None:\n",
    "    raise FileNotFoundError(f\"conf/settings.dev.yaml not found in {_here} or any parent\")\n",
    "CONFIG = REPO_ROOT / \"conf\" / \"settings.dev.yaml\"\n",
    "\n",
    "if IN_DATABRICKS:\n",
    "    sys.path.insert(0, str(REPO_ROOT / \"src\"))\n",
    "\n",
    "    # Databricks compute doesn't come with this repo's dependencies\n",
    "    # pre-installed. Install only the few the runtime lacks\n",
    "    # (requirements-databricks.txt) - NOT requirements.txt, whose pins for\n",
    "    # pandas/pyarrow/pydantic/databricks-sdk and dev tools would fight the\n",
    "    # versions the runtime already has loaded.\n",
    "    import subprocess\n",
    "\n",
    "    subprocess.check_call(\n",
    "        [sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"-r\", str(REPO_ROOT / \"requirements-databricks.txt\")]\n",
    "    )"
   ]
  },
